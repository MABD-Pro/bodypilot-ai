:"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"La table Ciqual est publiée par l’unité Observatoire des Aliments de l'Agence nationale de sécurité sanitaire de l’alimentation, de l’environnement et du travail (Anses). Cette table renseigne sur la composition nutritionnelle des aliments les plus consommés en France. Elle est disponible en libre accès, sous les formats Excel et xml.\nLa version 2025 décrit la composition nutritionnelle de 3484 aliments consommés en France pour 74 constituants (glucides, amidon et sucres individuels, protéines, lipides et acides gras, vitamines, minéraux, valeurs énergétiques…)."},"dsDescriptionLanguage":{"typeName":"dsDescriptionLanguage","multiple":false,"typeClass":"controlledVocabulary","value":"French"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025-11-19"}}]},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["French"]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Agricultural Sciences","Chemistry"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"valeur nutritive"},"keywordTermURL":{"typeName":"keywordTermURL","multiple":false,"typeClass":"primitive","value":"https://loterre.istex.fr/Q1W/fr/page/?uri=http%3A%2F%2Fdata.loterre.fr%2Fark%3A%2F67375%2FQ1W-ZPV3885P-2"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Agroalimentaire"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://dx.doi.org/10.13143/lotr.7310"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"lipide"},"keywordTermURL":{"typeName":"keywordTermURL","multiple":false,"typeClass":"primitiv